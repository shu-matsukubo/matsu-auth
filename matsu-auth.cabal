cabal-version: 2.4
name: matsu-auth
version: 0.1.0.0
build-type: Simple

executable matsu-auth
  main-is: Main.hs
  other-modules: AuthView
  hs-source-dirs: app
  default-language: Haskell2010
  ghc-options: -Wall -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.18 && <5
    , aeson
    , base64
    , bcrypt
    , bytestring
    , http-types
    , http-api-data
    , lucid
    , postgresql-simple
    , process
    , resource-pool
    , servant-lucid
    , servant-server
    , text
    , time
    , uuid
    , uuid-types
    , wai
    , wai-cors
    , warp
